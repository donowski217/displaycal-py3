#!/usr/bin/env python3
import sys
from multiprocessing import freeze_support

# Must run before any DisplayCAL import: in a frozen build, multiprocessing
# children (the profile loader's WCS worker) run this script too, and
# importing DisplayCAL would set them up (logging, lock files) as if they were
# another instance of the profile loader.
freeze_support()

if sys.platform == "win32" and not (
    "--help" in sys.argv[1:] or "-V" in sys.argv[1:] or "--version" in sys.argv[1:]
):
    from DisplayCAL.main import main

    main("apply-profiles")
else:
    # Linux
    from DisplayCAL.profile_loader import main

    main()
